        },
        "Mediterranean Mood": {
            "subtext": "The band that embraced the Mediterranean vibe, giving the most points to Italy, Spain, Cyprus, Malta, Israel, and France.",
            "image_url": "/static/images/mediterranean.jpg"
        },
        "Moneybags": {
            "subtext": "The band whose points went to the richest economies — every 12-point vote sends a full national GDP into the bank, every 1-pointer sends 1/12. Big spender.",
