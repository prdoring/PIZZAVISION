        },
        "Slummin' It": {
            "subtext": "The band who rooted for the economic underdogs — same math as Moneybags, but the lowest GDP-weighted total wins.",
            "image_url": "/static/images/slummin_it.jpg"
        },
        "Extrovert": {
            "subtext": "The band whose points went to the most populous countries — 12-pointers send a full population, 1-pointers send 1/12. The people person.",
            "image_url": "/static/images/extrovert.jpg"
        },
        "Introvert": {
            "subtext": "The band who championed the small nations — the fewest people lined up behind their points.",
            "image_url": "/static/images/introvert.jpg"
        }
