# Copy to .env and fill in. The .env file is gitignored.
# Everything here is optional for a bare run: without keys the app still
# serves, but the AI onboarding steps fall back to their non-AI paths.

# Band names, per-field suggestions, image prompts, roasts.
OPENAI_API_KEY=

# Portrait generation (Nano Banana Pro).
GEMINI_API_KEY=

# Admin panel password. Defaults to "changeme" if unset.
ADMIN_PASSWORD=

# --- Cloud Run only -------------------------------------------------
# Setting GOOGLE_CLOUD_PROJECT flips all three stores to their cloud
# backends (Firestore for votes and config, GCS for images). Leave both
# unset for local dev; deploy.ps1 sets them on the deployed service.
# GOOGLE_CLOUD_PROJECT=
# PV_GCS_BUCKET=

# --- Optional: route roasts to Claude instead of OpenAI --------------
# ANTHROPIC_API_KEY=
# ROAST_PROVIDER=anthropic
# ANTHROPIC_ROAST_MODEL=claude-opus-4-7

# --- Optional: server ------------------------------------------------
# PORT=5000
# FLASK_DEBUG=false
